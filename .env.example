# ---- Required: free key from https://aistudio.google.com/apikey ----
GOOGLE_API_KEY=add-gemini-your-secret-key-here

# ---- Optional: models (all free-tier Gemini models) ----
LLM_MODEL=gemini-3.5-flash
AVAILABLE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# ---- Optional: PostgreSQL credentials (used by docker-compose) ----
POSTGRES_USER=agent
POSTGRES_PASSWORD=agentpass
POSTGRES_DB=agentdb

# ---- Optional ----
RAG_TOP_K=4
LOG_LEVEL=INFO
